{
  // Quiz Caixa Livre (Fluxo B) + painel /admin
  // No ar em https://quiz.leticiakratka.com.br (painel em /admin/), conta Cloudflare da Leticia.
  // A senha do painel é o secret ADMIN_PASSWORD (npx wrangler@3 secret put ADMIN_PASSWORD).
  "name": "quiz-cxl",
  "main": "src/worker.js",
  "compatibility_date": "2025-07-18",
  "workers_dev": false,
  "routes": [
    { "pattern": "quiz.leticiakratka.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  // KV do worker lck-tracking-meta-capi (só leitura aqui): lista de vendas da Eduzz pro funil
  "kv_namespaces": [
    { "binding": "TRACKING", "id": "2cc09a455ff84ca087c4c4016b7bb667" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-cxl",
      "database_id": "bce0b0e4-2f8e-430a-8bf2-970a4eac9d42"
    }
  ]
}
